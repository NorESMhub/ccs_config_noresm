#!/bin/bash -e

# Batch system directives
{{ batchdirectives }}


machine=$(./xmlquery --value MACH)
if [[ "$machine" == "olivia" ]]; then
module purge
module load NRIS/CPU
module load Python/3.12.3-GCCcore-13.3.0
module load NCO/5.2.9-intel-2024a-NorESM
elif [[ "$machine" == "betzy" ]]; then
module purge
module load NCO/5.1.9-iomkl-2022a
else
echo "no proper NCO"    
exit
fi

ntasks=16

# Set script name
sn=aggregate

# archive data
caseroot=$(./xmlquery --value CASEROOT)
archivedata=$(./xmlquery --value DOUT_S_ROOT)
casename=$(./xmlquery --value CASE)

# Concatenate history files into one file per year?  Both settings come from
# the case, so they are changed with xmlchange rather than by editing this
# script, and they survive ./case.setup --reset:
#
#   ./xmlchange DOUT_S_AGGREGATE=TRUE
#   ./xmlchange DOUT_S_AGGREGATE_STREAMS="cice.h1:365 mosart.h0a:12"
#
# The stream :count specification (e.g. cice.h1:365) specifies that a
# complete year must have 365 time samples The count is required: it
# is what distinguishes a finished year from one still being written,
# and without it a partial year would be concatenated.  Only years
# that are certainly complete are aggregated.  Input files are removed
# only after the record count of the aggregate has been verified against them.
#
# These are read here, while the working directory is still the case: xmlquery
# identifies the case from the directory it is run in, not from its own path,
# so it cannot be used once this script has cd'd to the archive.
AGGREGATE=0
if [[ "$(./xmlquery --value DOUT_S_AGGREGATE)" == "TRUE" ]]; then
  AGGREGATE=1
fi
AGGREGATE_STREAMS=$(./xmlquery --value DOUT_S_AGGREGATE_STREAMS)

# Having nothing to aggregate is not an error, so exit 0 rather than 1.
# config_workflow.xml makes case.compress depend on this job, and every batch
# system expresses that dependency as "run only if the other job succeeded".
# A non-zero exit here therefore leaves compression permanently unrun: the
# dependency can never be satisfied and the queued job is eventually discarded.
# Failure from this script should only occur where that outcome is genuinely wanted.
if [ ! -d $archivedata ]; then
  echo "${sn}: ${archivedata} is not a directory, nothing to aggregate."
  exit 0
fi
cd $archivedata

lid="$(date +%y%m%d-%H%M%S)"

# Functions

aggregate_cmd () {
  # Combine one year of one history stream into a single file.
  #
  # Concatenates <prefix>.<year>-*.nc into <prefix>.<year>.nc along the time
  # dimension, then checks that the result holds one record per input file before
  # deleting any of them.  If that check fails, the part built so far is discarded
  # and every input is kept, so nothing can be lost to a partial or corrupt
  # concatenation.
  #
  # Does nothing if the year has no files, or if its combined file already exists,
  # which is what makes the job safe to run repeatedly over the same archive.
  #
  #   $1  directory holding the files, e.g. <archive>/ice/hist
  #   $2  filename prefix through the stream, e.g. <case>.cice.h1
  #   $3  four digit year
  #
  # Returns non-zero only when the record count did not verify.
  local dir=$1 prefix=$2 year=$3
  local inputs nin out nout timestamp hist

  inputs=$(find ${dir} -maxdepth 1 -name "${prefix}.${year}-*.nc" 2>/dev/null | sort)
  if [ -z "$inputs" ]; then
    return 0
  fi
  nin=$(echo "$inputs" | wc -l | tr -d ' ')

  # aggregate_loop checks this too and reports it; this is a backstop for a
  # file that appeared between that check and this one.
  out=${dir}/${prefix}.${year}.nc
  if [ -f "$out" ]; then
    echo "aggregate: ERROR $out appeared while ${year} was being aggregated - inputs kept" >&2
    echo "${prefix}.${year} (aggregate appeared mid-run)" >> $AGGREGATE_FAILURES
    return 1
  fi

  echo "aggregate: $out <- $nin files"
  # -h suppresses ncrcat's own history entry, which names every input file
  # (~21 KB on one line for a year of dailies).  A compact one is added below.
  if ! ncrcat -O -h $inputs ${out}_tmp; then
    echo "aggregate: ERROR ncrcat failed for ${prefix}.${year} - inputs kept" >&2
    # ncrcat writes through its own temp file and does not remove it when it
    # dies, so clear that as well as our own partial output.
    rm -f ${out}_tmp ${out}_tmp.pid*.ncrcat.tmp
    echo "${prefix}.${year} (ncrcat failed)" >> $AGGREGATE_FAILURES
    return 1
  fi

  nout=$(ncdump -h ${out}_tmp | sed -n 's/.*time = UNLIMITED ; \/\/ (\([0-9]*\) currently).*/\1/p')
  if [ "$nout" != "$nin" ]; then
    echo "aggregate: ERROR $out has $nout records, expected $nin - inputs kept" >&2
    rm -f ${out}_tmp
    # Record the failure by name.  This runs in a background subshell, so a
    # shell variable could not be seen by aggregate_loop; a file can.
    echo "${prefix}.${year} ($nout records, expected $nin)" >> $AGGREGATE_FAILURES
    return 1
  fi

  # Record how the file was built by appending one line to its history
  # attribute.  The five comma-separated fields of -a are
  # name,variable,mode,type,value:
  #
  #   history  the attribute to edit
  #   global   a file-level attribute, not one belonging to a variable
  #   a        append, which keeps the model's own history rather than
  #            replacing it (that history is inherited from the first input)
  #   c        the value is of type char
  #
  # -h stops ncatted from adding its own command line after ours.
  timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
  hist="\n${timestamp}: case.aggregate: "
  hist+="ncrcat of ${nin} files matching ${prefix}.${year}-*.nc"
  if ! ncatted -O -h -a history,global,a,c,"$hist" ${out}_tmp; then
    echo "aggregate: WARNING could not add a history entry to $out" >&2
  fi

  mv ${out}_tmp $out
  chmod go+r $out
  rm -f $inputs
  echo "aggregate: removed $nin input files"
}


aggregate_loop () {
  [ $AGGREGATE -eq 1 ] || return 0

  # Each year is concatenated in a background subshell, so failures cannot be
  # counted in a shell variable.  Each one appends a line here instead, and the
  # summary at the end of this function reports them.
  AGGREGATE_FAILURES=$(mktemp ${TMPDIR:-/tmp}/aggregate_failures.XXXXXX)

  # ncrcat does the concatenation and ncdump verifies the result before any
  # input is deleted, so both must be present.  Loading NCO is handled above
  # and is machine specific; if it did not happen, skip aggregation rather
  # than abort, so that compression and the rsync still run.
  for tool in ncrcat ncdump; do
    if ! command -v $tool >/dev/null 2>&1; then
      echo "aggregate: ERROR $tool not found, skipping aggregation (is NCO loaded?)" >&2
      rm -f $AGGREGATE_FAILURES
      return 0
    fi
  done
  for histdir in $(find . -type d -wholename "*/hist"); do
    for stream in $AGGREGATE_STREAMS; do
      # Each entry must be <component>.<stream>:<count>, where count is how
      # many files a complete year of that stream contains, e.g. cice.h1:365
      # for daily output and mosart.h0a:12 for monthly.  The count is required:
      # it is what distinguishes a finished year from one still being written,
      # and without it a partial year would be concatenated.
      stream_name=${stream%%:*}
      stream_count=${stream#*:}

      # Stripping up to the colon returns the string unchanged when there is no
      # colon, so an unchanged value means the count is missing altogether.
      no_colon_present=false
      [[ "$stream_count" == "$stream" ]] && no_colon_present=true

      # A count must be a plain positive integer.  Rejecting 0 matters: it
      # would make every year look complete, including one with no files.
      count_is_positive_integer=true
      echo "$stream_count" | grep -qE '^[1-9][0-9]*$' || count_is_positive_integer=false

      if $no_colon_present || ! $count_is_positive_integer; then
        echo "aggregate: ERROR '${stream}' is not of the form <component>.<stream>:<count>, skipping" >&2
        echo "${stream} (malformed DOUT_S_AGGREGATE_STREAMS entry)" >> $AGGREGATE_FAILURES
        continue
      fi

      # Collect the years for which per-date history files exist, e.g. 1526
      # from <case>.cice.h1.1526-01-01.nc.  The trailing hyphen in the pattern
      # is what distinguishes those from an already aggregated year such as
      # <case>.cice.h1.1526.nc, so an aggregate is never used as input.
      # use 'find' rather than a shell 'glob': a glob would expand every per-date file
      # of every year onto one command line, which can exceed ARG_MAX on a
      # large archive (a decade of daily output is thousands of files).
      prefix=${casename}.${stream_name}
      years=$(find ${histdir} -maxdepth 1 -name "${prefix}.*-*.nc" 2>/dev/null |
               sed -n "s|.*/${prefix}\.\([0-9][0-9][0-9][0-9]\)-.*|\1|p" | sort -u)
      if [ -z "$years" ]; then
          continue
      fi

      # Loop over years
      for year in $years; do
        # This year list was built from per-date files, so an aggregate that
        # already exists for this year means per-date files have turned up
        # beside it.  That cannot happen in normal operation - inputs are
        # deleted as soon as their aggregate verifies - so it means output
        # landed after the year had been aggregated, typically a re-run segment
        # or a run still writing a year this job had already treated as done.
        # Appending risks duplicate records and deleting risks losing data, so
        # touch neither and report it: left to the gate below, it would be
        # dismissed every cycle as an incomplete year and never looked at.
        if [ -f "${histdir}/${prefix}.${year}.nc" ]; then
          nleft=$(find ${histdir} -maxdepth 1 -name "${prefix}.${year}-*.nc" 2>/dev/null | wc -l | tr -d ' ')
          echo "aggregate: ERROR ${prefix}.${year}.nc already exists but ${nleft} per-date file(s) for ${year} are also present - left alone" >&2
          echo "${prefix}.${year} (aggregate exists alongside ${nleft} per-date file(s))" >> $AGGREGATE_FAILURES
          continue
        fi

        # A year is aggregated only once all of its files are on disk, so a
        # year still being written is skipped on the evidence rather than on
        # any assumption about which year happens to be last.
        nfiles=$(find ${histdir} -maxdepth 1 -name "${prefix}.${year}-*.nc" 2>/dev/null | wc -l | tr -d ' ')
        if [ "$nfiles" -lt "$stream_count" ]; then
          echo "aggregate: ${prefix}.${year} has ${nfiles} of ${stream_count} files, leaving it alone"
          continue
        fi

        # Run up to $ntasks concatenations at once, the same way convert_loop
        # throttles convert_cmd.  The trailing & is what gives the parallelism:
        # it backgrounds the call so the loop moves straight on to the next
        # year instead of waiting for this ncrcat to finish.  `jobs -p` lists
        # this shell's background jobs, so the count is the concurrency; while
        # it is at the limit, sleep and look again.  The || true keeps one
        # failed year from aborting the rest of the archiving.
        while :; do
          if [ $(jobs -p|wc -l) -lt $ntasks ]; then
            aggregate_cmd "$histdir" "$prefix" "$year" || true &
            break
          fi
          sleep 1s
        done

      done # end of year loop
    done # end of stream loop
  done # end of histdir loop
  # block until every backgrounded concatenation has finished, so that the
  # message below is true and the compression pass that follows never sees a
  # half written file
  wait

  # Report what failed.  The job still exits 0 (see the note at the top of this
  # script), so this summary is the only signal that something went wrong -
  # make it explicit rather than silently claiming success.
  nfail=$(wc -l < $AGGREGATE_FAILURES | tr -d ' ')
  if [ "$nfail" -gt 0 ]; then
    echo "${sn}: WARNING ${nfail} aggregation(s) FAILED; all of their input files were kept:" >&2
    sed 's/^/  /' $AGGREGATE_FAILURES >&2
  else
    echo "${sn}: aggregation completed, no failures."
  fi
  rm -f $AGGREGATE_FAILURES
}

# Run the aggregation, logging to aggregate.log.  This call is not backgrounded:
# the parallelism is inside aggregate_loop, which waits for every concatenation
# before it returns.
#
# 2>&1 sends the error messages to the log as well.  Everything this job has to
# say belongs in one place: the per-year errors explain the failure summary, and
# without this they would land in the batch system's stderr file instead, away
# from the summary that refers to them.
echo $(date) > $archivedata/aggregate.log.$lid
aggregate_loop >> $archivedata/aggregate.log.$lid 2>&1
echo $(date) >> $archivedata/aggregate.log.$lid

unset SLURM_MEM_PER_NODE
unset SLURM_MEM_PER_CPU

# Exit 0 even if something above went wrong.  As described at the top,
# case.compress runs only if this job succeeds, so an aggregation problem must
# not be allowed to stop compression as well.  Anything that did go wrong is
# reported in aggregate.log, and a failed year keeps all of its input files.
exit 0
